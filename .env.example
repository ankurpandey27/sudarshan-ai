# ===================== SERVER =====================
PORT=9999
NODE_ENV=development
API_PREFIX=api/v1

# ---- Security ----
# Comma-separated allowed CORS origins. Empty = same-origin / API clients only.
CORS_ORIGINS=http://localhost:3000

# ---- Swagger / docs ----
SWAGGER_ENABLED=true

# ===================== LLM CONFIGURATION =====================
# Strategy: primary | cheap_then_accurate | consensus | fallback
LLM_STRATEGY=cheap_then_accurate
PRIMARY_LLM=claude
SECONDARY_LLM=ollama
TERTIARY_LLM=gpt

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# ===================== TOKEN OPTIMIZATION =====================
ENABLE_KEYWORD_FILTERS=true
ENABLE_DECISION_CACHE=true
ENABLE_PATTERN_LEARNING=true
TOKEN_BUDGET_PER_DAY=100000
WARN_TOKEN_USAGE=80000
PROMPT_COMPRESSION=aggressive

# ===================== KNOWLEDGE BASE =====================
REDIS_URL=redis://localhost:6379
# MongoDB is the single datastore (records, embeddings, learned patterns).
MONGO_URI=mongodb://localhost:27017/job_agent
MONGO_DB_NAME=job_agent
USE_OLLAMA_EMBEDDINGS=true
EMBEDDING_DIMS=0

# ===================== APPLICATION =====================
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
MAX_APPLICATIONS_PER_DAY=30

SEARCH_KEYWORDS=Backend Developer,NodeJS Developer,NestJS Developer
SEARCH_LOCATIONS=India,Bangalore,Remote
SEARCH_INTERVAL_MINUTES=30

# ===================== DISCOVERY =====================
DISCOVERY_MAX_PER_SEARCH=10

# ===================== AGENT LOOP =====================
AGENT_ENABLED=false
# AGENT_LOOP_MINUTES defaults to SEARCH_INTERVAL_MINUTES
# AGENT_LOOP_MINUTES=180

# ===================== PROFILE =====================
PROFILE_NAME=Software Engineer
PROFILE_CURRENT_ROLE=Backend Developer
PROFILE_YEARS_EXPERIENCE=2
PROFILE_SKILLS=Node.js,TypeScript,PostgreSQL
PROFILE_EXPECTED_SALARY=0
PROFILE_SALARY_CURRENCY=INR
PROFILE_LOCATION=India
PROFILE_REMOTE=true
PROFILE_SUMMARY=

# ===================== SCORING =====================
MIN_APPLY_SCORE=75
MIN_MANUAL_REVIEW_SCORE=60
WEIGHT_TECHNICAL=50
WEIGHT_SALARY=25
WEIGHT_LOCATION=25

# ===================== THROTTLING =====================
BASE_DELAY_MS=3000
ADAPTIVE_THROTTLING=true
RATE_LIMIT_SAFETY_MARGIN=5

# ===================== BROWSER =====================
BROWSER_POOL_SIZE=5
BROWSER_ROTATION_AFTER=15
HEADLESS=true
# Set to force a specific Chrome/Chromium binary; otherwise resolved from OS.
PUPPETEER_EXECUTABLE_PATH=
# Simulated human pacing between browser actions (ms + jitter).
DELAY_BETWEEN_ACTIONS_MS=3000
ACTION_JITTER_MS=1500
# Hard cap for a single Chrome launch (boot never blocks longer than this).
BROWSER_LAUNCH_TIMEOUT_MS=30000

# ===================== AGENTS =====================
PRIMARY_AGENT=linkedin
ENABLE_BACKUP_AGENT=true
HEARTBEAT_INTERVAL_MS=5000
HEARTBEAT_MISSED=2
AGENT_RESTART_DELAY_MS=20000

# ===================== QUEUE =====================
QUEUE_CONCURRENCY=3
QUEUE_MAX_ATTEMPTS=3

# ===================== LOGGING =====================
LOG_LEVEL=info
STRUCTURED_LOGS=true
LOG_DIR=logs